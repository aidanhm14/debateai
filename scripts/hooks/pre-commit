#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────
# Auto-bump the service-worker CACHE_NAME when client-side files
# change in a DebateAI commit.
#
# AGENTS.md says: "Bump CACHE_NAME in BOTH sw.js files when HTML/bundle
# changes." Skipping the bump = users on stale caches for hours.
# This hook automates the bump so it can never be forgotten.
#
# Triggers on any staged .html/.js/.css/.mjs under app/ (excluding
# the netlify functions dir, which is server-side only and not
# served to the browser) or at the repo root.
#
# If the user already staged sw.js themselves, the hook trusts that
# and exits cleanly — no double-bump.
#
# If the repo isn't DebateAI (no app/sw.js + sw.js pair), the hook
# is a no-op so it stays safe for any other repo that happens to
# share this hooks directory.
#
# Soft-fail: any unexpected error just warns and lets the commit
# proceed rather than blocking the dev's flow.
# ──────────────────────────────────────────────────────────────────

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$REPO_ROOT" ] && exit 0

SW_APP="$REPO_ROOT/app/sw.js"
SW_ROOT="$REPO_ROOT/sw.js"

# DebateAI-specific guard. Other repos that share this hooks dir
# won't have both files and will skip silently.
[ -f "$SW_APP" ] || exit 0
[ -f "$SW_ROOT" ] || exit 0

STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
[ -z "$STAGED" ] && exit 0

# ──────────────────────────────────────────────────────────────────
# Service-worker integrity guard. On 2026-08-18 both sw.js files
# reached origin/main carrying unresolved conflict markers around
# CACHE_NAME (a rebase resolution gone wrong). That is a JS syntax
# error: browsers keep the previous service worker and users stay on
# the stale cache indefinitely. Checks the STAGED copy (what the
# commit will actually contain) for conflict markers and runs it
# through `node --check`. Hard-fails, like the price guard.
# ──────────────────────────────────────────────────────────────────
sw_integrity() {
  # $1 = repo-relative path of a staged sw file (e.g. app/sw.js)
  local content
  content="$(git show ":$1" 2>/dev/null || true)"
  if [ -z "$content" ]; then
    echo "[sw-guard] BLOCKED: staged $1 is empty. A truncated service worker breaks caching for every visitor." >&2
    return 1
  fi
  if printf '%s\n' "$content" | grep -nE '^(<{7} |={7}$|>{7} |[|]{7})' >&2; then
    echo "[sw-guard] BLOCKED: staged $1 contains unresolved merge conflict markers (lines above)." >&2
    echo "[sw-guard] That is a JS syntax error: browsers keep the previous service worker and users stay on the stale cache. Resolve the conflict and re-stage. Never bypass with --no-verify." >&2
    return 1
  fi
  if command -v node >/dev/null 2>&1; then
    local tmpbase tmp
    tmpbase="$(mktemp)"; tmp="$tmpbase.js"
    printf '%s\n' "$content" >"$tmp"
    if ! node --check "$tmp" >"$tmpbase.log" 2>&1; then
      echo "[sw-guard] BLOCKED: staged $1 fails node --check (syntax error):" >&2
      sed "s|$tmp|$1|g" "$tmpbase.log" | head -8 >&2
      echo "[sw-guard] Fix the syntax error and re-stage. Never bypass with --no-verify." >&2
      rm -f "$tmpbase" "$tmp" "$tmpbase.log"
      return 1
    fi
    rm -f "$tmpbase" "$tmp" "$tmpbase.log"
  fi
  return 0
}

# ──────────────────────────────────────────────────────────────────
# Canonical-price guard. Blocks a commit that stages an off-canonical
# price string in a user-facing surface — catches pricing drift and
# agents "correcting" prices backwards to superseded values. Canonical
# tiers + rationale + exclusions live in scripts/check-prices.mjs.
# Hard-fails (blocks) on a real violation; soft-skips when node or the
# script are unavailable so it never wedges a non-DebateAI repo.
# ──────────────────────────────────────────────────────────────────
PRICE_GUARD="$REPO_ROOT/scripts/check-prices.mjs"
if [ -f "$PRICE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/check-prices.mjs); then
    echo "[price-guard] commit blocked — fix the price(s) above. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Judge-integrity guard. Blocks a commit that breaks a promise the
# public /judge-integrity page makes: the season calendar staying
# contiguous, the rubric hash staying content-addressed, an even panel
# split staying unresolved instead of tie-broken, appeals staying
# human-only, and the settlement path staying free of any rake or
# side-dependent fee.
#
# Why a hook and not just a test anyone can run: every one of those is
# a claim published to users and quotable in a dispute, so a commit
# that quietly falsifies one should not be able to reach main. Same
# hard-fail, soft-skip posture as the price guard.
# ──────────────────────────────────────────────────────────────────
JUDGE_GUARD="$REPO_ROOT/scripts/test-judge-integrity.mjs"
if [ -f "$JUDGE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-judge-integrity.mjs >/tmp/judge-guard.log 2>&1); then
    echo "[judge-guard] commit blocked — the judge integrity promises no longer hold:" >&2
    grep '^FAIL' /tmp/judge-guard.log >&2 || tail -20 /tmp/judge-guard.log >&2
    echo "[judge-guard] see scripts/test-judge-integrity.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Judge-delivery guard. Manner and length are reader-facing controls on
# the ballot, and the promise attached to them is one a debater cannot
# check for themselves: asking for a kinder ballot changes the WORDS and
# never the call, the points, or which flaws get named. A manner that
# quietly went easier would inflate speaker points against a leaderboard
# that ranks everyone on one scale, invisibly, because nobody ever sees
# both versions of the same round.
# ──────────────────────────────────────────────────────────────────
DELIVERY_GUARD="$REPO_ROOT/scripts/test-judge-delivery.mjs"
if [ -f "$DELIVERY_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-judge-delivery.mjs >/tmp/judge-delivery-guard.log 2>&1); then
    echo "[judge-delivery] commit blocked — manner or length no longer holds its line:" >&2
    grep '^  FAIL' /tmp/judge-delivery-guard.log >&2 || tail -20 /tmp/judge-delivery-guard.log >&2
    echo "[judge-delivery] see scripts/test-judge-delivery.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Speaker-score guard. The headline points on every ballot are derived
# from the scored axes at published weights, and those weights are a
# claim about what winning an argument is made of. A silent change to
# one re-scores every future round, so it is a rubric change and this
# blocks it the same way the judge guard does.
# ──────────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────────
# Age-bracket guard. Under 18 and 18-plus are paired as separate
# fields, and the reason is safeguarding rather than prize money: a
# live 1:1 video round between a minor and an adult stranger is the
# thing the split exists to prevent. The guard tests the real matcher
# and also reads tournament-dropin.mjs, because a single pool restored
# there would pass every behavioural assertion on its own.
# ──────────────────────────────────────────────────────────────────
BRACKET_GUARD="$REPO_ROOT/scripts/test-tournament-bracket.mjs"
if [ -f "$BRACKET_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-tournament-bracket.mjs >/tmp/bracket-guard.log 2>&1); then
    echo "[bracket-guard] commit blocked — the age split no longer holds:" >&2
    tail -20 /tmp/bracket-guard.log >&2
    echo "[bracket-guard] see scripts/test-tournament-bracket.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Director wall. The one word per room a director reads on an event
# day, and the two states (stalled, one-seat) that send them looking
# for a missing person. Guarded because this surface is only ever used
# live, which is the worst moment to discover a state never fires:
# the first version timed a stall off `lastSeenAt`, a field the 30s
# heartbeat rewrites, so `stalled` could not have fired in production.
# ──────────────────────────────────────────────────────────────────
DIRECTOR_GUARD="$REPO_ROOT/scripts/test-director.mjs"
if [ -f "$DIRECTOR_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-director.mjs >/tmp/director-guard.log 2>&1); then
    echo "[director-guard] commit blocked — the room wall no longer reads rooms correctly:" >&2
    tail -20 /tmp/director-guard.log >&2
    echo "[director-guard] see scripts/test-director.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Motion draft. The pre-round veto decides what two real people argue
# and which side each of them takes, so a regression here is a round
# that opens wrong in front of an opponent rather than a stack trace
# anybody sees. The guards that matter: a client cannot strike more
# than its allowance (four strikes from one side leaves one survivor
# of that side's choosing, which is the whole draft), a client cannot
# exercise the other debater's power, and a timeout resolves the same
# way on both sides.
# ──────────────────────────────────────────────────────────────────
DRAFT_GUARD="$REPO_ROOT/scripts/test-motion-draft.mjs"
if [ -f "$DRAFT_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-motion-draft.mjs >/tmp/draft-guard.log 2>&1); then
    echo "[draft-guard] commit blocked — the motion draft no longer holds:" >&2
    tail -20 /tmp/draft-guard.log >&2
    echo "[draft-guard] see scripts/test-motion-draft.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Silence-hallucination guard. A transcription model handed ten seconds
# of silence returns the prompt it was given, not nothing, and our prompt
# is a debate glossary — so the confabulation arrives debate-shaped and
# nothing downstream questions it. One live round shipped a constructive
# whose whole transcript was an invented sentence about how well the
# speaker had done. The gate must keep refusing the prompt back while
# still letting real speech through, including speech that reuses the
# jargon the prompt lists.
# ──────────────────────────────────────────────────────────────────
ECHO_GUARD="$REPO_ROOT/scripts/test-transcribe-echo.mjs"
if [ -f "$ECHO_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-transcribe-echo.mjs >/tmp/echo-guard.log 2>&1); then
    echo "[echo-guard] commit blocked — the silence gate no longer holds:" >&2
    tail -20 /tmp/echo-guard.log >&2
    echo "[echo-guard] see scripts/test-transcribe-echo.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

SPEAKS_GUARD="$REPO_ROOT/scripts/test-speaker-score.mjs"
if [ -f "$SPEAKS_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-speaker-score.mjs >/tmp/speaks-guard.log 2>&1); then
    echo "[speaks-guard] commit blocked — the speaker score no longer holds:" >&2
    grep '^FAIL' /tmp/speaks-guard.log >&2 || tail -20 /tmp/speaks-guard.log >&2
    echo "[speaks-guard] see scripts/test-speaker-score.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Judge-roster guard. The rotating round judge exists in two files
# (app/js/judge-roster.js client, lib/judge-roster.mjs server) and
# the draw is (hash % length), so a one-sided edit or reorder makes
# the ballot apply a different judge than the intro card showed.
# Same hard-fail, soft-skip posture.
# ──────────────────────────────────────────────────────────────────
ROSTER_GUARD="$REPO_ROOT/scripts/test-judge-roster.mjs"
if [ -f "$ROSTER_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-judge-roster.mjs >/tmp/judge-roster-guard.log 2>&1); then
    echo "[judge-roster-guard] commit blocked - client and server judge rosters have drifted:" >&2
    grep '^FAIL' /tmp/judge-roster-guard.log >&2 || tail -20 /tmp/judge-roster-guard.log >&2
    echo "[judge-roster-guard] see scripts/test-judge-roster.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Debate-brain guard. The stored brain is concatenated into the system
# prompt of every future round its owner runs, so the allow-list in
# lib/brain-schema.mjs is a prompt-injection boundary rather than a
# tidiness rule, and the feature gate is what keeps the AI JUDGE from
# ever learning who it is scoring. Both were verified non-vacuous by
# deliberately breaking them. Same hard-fail, soft-skip posture.
# ──────────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────────
# Eval-corpus guard. The rule it pins: a verdict our own judge wrote
# must never become the ground truth our own judge is scored against.
# That mistake does not surface as a failure, it surfaces as a very
# good accuracy number, so it needs a guard rather than care.
# ──────────────────────────────────────────────────────────────────
EVALCORPUS_GUARD="$REPO_ROOT/scripts/test-eval-corpus.mjs"
if [ -f "$EVALCORPUS_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-eval-corpus.mjs >/tmp/eval-corpus-guard.log 2>&1); then
    echo "[eval-corpus-guard] commit blocked - the benchmark label rules no longer hold:" >&2
    tail -20 /tmp/eval-corpus-guard.log >&2
    echo "[eval-corpus-guard] see scripts/test-eval-corpus.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

BRAIN_GUARD="$REPO_ROOT/scripts/test-brain.mjs"
if [ -f "$BRAIN_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-brain.mjs >/tmp/brain-guard.log 2>&1); then
    echo "[brain-guard] commit blocked - the debate-brain guarantees no longer hold:" >&2
    tail -20 /tmp/brain-guard.log >&2
    echo "[brain-guard] see scripts/test-brain.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Avatar option guard. The designer, the renderer, the account sync and
# the shared server allow-list all carry the same five option lists, and
# the last three are sanitisers with fallbacks, so drift between them
# does not throw: it silently replaces somebody's saved avatar with the
# default. That shipped once (2026-08-24, reported as "it's not saving my
# profile picture") and is invisible in a diff, so it gets a guard.
# ──────────────────────────────────────────────────────────────────
AVATAR_GUARD="$REPO_ROOT/scripts/test-avatar-design.mjs"
if [ -f "$AVATAR_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-avatar-design.mjs >/tmp/avatar-guard.log 2>&1); then
    echo "[avatar-guard] commit blocked - the avatar option lists disagree:" >&2
    tail -20 /tmp/avatar-guard.log >&2
    echo "[avatar-guard] see scripts/test-avatar-design.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Plan-price guard. check-prices.mjs above polices price STRINGS in
# user-facing HTML and it works; on 2026-08-24 it was passing while the
# live Stripe Individual price charged $5.00/MONTH against an
# advertised $10/year, because a Stripe price id is opaque and nothing
# compared the copy to the object money settles against. This asserts
# the canonical amounts in lib/plans.mjs match what the site prints,
# that no canonical label is a string check-prices.mjs bans, that the
# withdrawn Lifetime door stays shut, and that the real drift is
# rejected by priceMatchesCanonical. Verified non-vacuous by mutation.
# Same hard-fail, soft-skip posture.
# ──────────────────────────────────────────────────────────────────
PLAN_GUARD="$REPO_ROOT/scripts/test-plans.mjs"
if [ -f "$PLAN_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-plans.mjs >/tmp/plan-guard.log 2>&1); then
    echo "[plan-guard] commit blocked - what we charge no longer matches what we advertise:" >&2
    tail -20 /tmp/plan-guard.log >&2
    echo "[plan-guard] see scripts/test-plans.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# AI-use screen guard. The report-triggered transcript screen is
# EVIDENCE for a human reviewer, never a verdict: no strike/ban/eject
# path may exist off it, style alone can never produce a 'strong'
# verdict (that cap is the whole fairness argument for second-language
# debaters), and the judge never sees the analysis. Those promises are
# printed to users in the report modal, so breaking one is a lie on a
# safety surface. Same hard-fail, soft-skip posture.
# ──────────────────────────────────────────────────────────────────
AIUSE_GUARD="$REPO_ROOT/scripts/test-ai-use.mjs"
if [ -f "$AIUSE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-ai-use.mjs >/tmp/ai-use-guard.log 2>&1); then
    echo "[ai-use-guard] commit blocked - the AI-use screen promises no longer hold:" >&2
    tail -20 /tmp/ai-use-guard.log >&2
    echo "[ai-use-guard] see scripts/test-ai-use.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Record-seed guard. A seed can be revised by ADDING records and only by
# adding: the rating recomputes over the union of every row ever
# claimed, so nobody can drop the tournament that dragged their number
# down and re-seed on the good half. That one property is the whole
# reason revision is safe, and it lives in two places that can drift
# apart (the pure merge in lib/record-seed.mjs and the transaction in
# record-import.mjs), so the suite asserts both and reads the endpoint
# source to prove the helper is actually on the path. Verified
# non-vacuous against six deliberate mutations. Same posture.
# ──────────────────────────────────────────────────────────────────
SEED_GUARD="$REPO_ROOT/scripts/test-record-seed.mjs"
if [ -f "$SEED_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-record-seed.mjs >/tmp/seed-guard.log 2>&1); then
    echo "[seed-guard] commit blocked - the record-seed guarantees no longer hold:" >&2
    tail -20 /tmp/seed-guard.log >&2
    echo "[seed-guard] see scripts/test-record-seed.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Brain-health guard. The probe redacts the provider's raw error before
# publishing, because that text names an account's billing state and the
# endpoint is public. It also has to stay in lockstep with the /judge
# picker: a brain probed but not offered (or offered but not probed)
# reports health for something nobody can select. Same posture.
# ──────────────────────────────────────────────────────────────────
BRAIN_HEALTH_GUARD="$REPO_ROOT/scripts/test-brain-health.mjs"
if [ -f "$BRAIN_HEALTH_GUARD" ] && command -v node >/dev/null 2>&1; then
