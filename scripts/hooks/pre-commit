    echo "[discourse-guard] see scripts/test-discourse.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Opinion-panel guard. The panel is a measurement instrument: a reworded
# stem or a duplicate id silently breaks comparability with every answer
# already collected, and nothing about the incoming data looks wrong
# afterwards. Also asserts the aggregate maths ignores repeat answers, so
# a returning panelist cannot drag the published percentages. Verified
# non-vacuous by injecting each regression and watching it fail.
# ──────────────────────────────────────────────────────────────────
