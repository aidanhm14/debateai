#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────
# Auto-bump the service-worker CACHE_NAME when client-side files
# change in a DebateAI commit.
#
# AGENTS.md says: "Bump CACHE_NAME in BOTH sw.js files when HTML/bundle
# changes." Skipping the bump = users on stale caches for hours.
# This hook automates the bump so it can never be forgotten.
#
# Triggers on any staged .html/.js/.css/.mjs under app/ (excluding
# the netlify functions dir, which is server-side only and not
# served to the browser) or at the repo root.
#
# If the user already staged sw.js themselves, the hook trusts that
# and exits cleanly — no double-bump.
#
# If the repo isn't DebateAI (no app/sw.js + sw.js pair), the hook
# is a no-op so it stays safe for any other repo that happens to
# share this hooks directory.
#
# Soft-fail: any unexpected error just warns and lets the commit
# proceed rather than blocking the dev's flow.
# ──────────────────────────────────────────────────────────────────

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -z "$REPO_ROOT" ] && exit 0

SW_APP="$REPO_ROOT/app/sw.js"
SW_ROOT="$REPO_ROOT/sw.js"

# DebateAI-specific guard. Other repos that share this hooks dir
# won't have both files and will skip silently.
[ -f "$SW_APP" ] || exit 0
[ -f "$SW_ROOT" ] || exit 0

STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
[ -z "$STAGED" ] && exit 0

# ──────────────────────────────────────────────────────────────────
# Canonical-price guard. Blocks a commit that stages an off-canonical
# price string in a user-facing surface — catches pricing drift and
# agents "correcting" prices backwards to superseded values. Canonical
# tiers + rationale + exclusions live in scripts/check-prices.mjs.
# Hard-fails (blocks) on a real violation; soft-skips when node or the
# script are unavailable so it never wedges a non-DebateAI repo.
# ──────────────────────────────────────────────────────────────────
PRICE_GUARD="$REPO_ROOT/scripts/check-prices.mjs"
if [ -f "$PRICE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/check-prices.mjs); then
    echo "[price-guard] commit blocked — fix the price(s) above. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Judge-integrity guard. Blocks a commit that breaks a promise the
# public /judge-integrity page makes: the season calendar staying
# contiguous, the rubric hash staying content-addressed, an even panel
# split staying unresolved instead of tie-broken, appeals staying
# human-only, and the settlement path staying free of any rake or
# side-dependent fee.
#
# Why a hook and not just a test anyone can run: every one of those is
# a claim published to users and quotable in a dispute, so a commit
# that quietly falsifies one should not be able to reach main. Same
# hard-fail, soft-skip posture as the price guard.
# ──────────────────────────────────────────────────────────────────
JUDGE_GUARD="$REPO_ROOT/scripts/test-judge-integrity.mjs"
if [ -f "$JUDGE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-judge-integrity.mjs >/tmp/judge-guard.log 2>&1); then
    echo "[judge-guard] commit blocked — the judge integrity promises no longer hold:" >&2
    grep '^FAIL' /tmp/judge-guard.log >&2 || tail -20 /tmp/judge-guard.log >&2
    echo "[judge-guard] see scripts/test-judge-integrity.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Debate-brain guard. The stored brain is concatenated into the system
# prompt of every future round its owner runs, so the allow-list in
# lib/brain-schema.mjs is a prompt-injection boundary rather than a
# tidiness rule, and the feature gate is what keeps the AI JUDGE from
# ever learning who it is scoring. Both were verified non-vacuous by
# deliberately breaking them. Same hard-fail, soft-skip posture.
# ──────────────────────────────────────────────────────────────────
BRAIN_GUARD="$REPO_ROOT/scripts/test-brain.mjs"
if [ -f "$BRAIN_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-brain.mjs >/tmp/brain-guard.log 2>&1); then
    echo "[brain-guard] commit blocked - the debate-brain guarantees no longer hold:" >&2
    tail -20 /tmp/brain-guard.log >&2
    echo "[brain-guard] see scripts/test-brain.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Brain-health guard. The probe redacts the provider's raw error before
# publishing, because that text names an account's billing state and the
# endpoint is public. It also has to stay in lockstep with the /judge
# picker: a brain probed but not offered (or offered but not probed)
# reports health for something nobody can select. Same posture.
# ──────────────────────────────────────────────────────────────────
BRAIN_HEALTH_GUARD="$REPO_ROOT/scripts/test-brain-health.mjs"
if [ -f "$BRAIN_HEALTH_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-brain-health.mjs >/tmp/brain-health-guard.log 2>&1); then
    echo "[brain-health-guard] commit blocked - the brain probe's guarantees no longer hold:" >&2
    tail -20 /tmp/brain-health-guard.log >&2
    echo "[brain-health-guard] see scripts/test-brain-health.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Sender guard. Resend authenticates the sending DOMAIN, not the
# mailbox, and it REJECTS an unverified From at the API rather than
# bouncing it later, so a wrong sender is a run of silent 403s in an
# error tally nobody reads. That is not hypothetical: it is how Spar
# Night mailed zero people between 2026-07-22 and 08-05. The check
# asks Resend what is verified instead of trusting a hardcoded list,
# and it has to keep failing CLOSED when the answer cannot be had.
# ──────────────────────────────────────────────────────────────────
SENDER_GUARD="$REPO_ROOT/scripts/test-sender-verify.mjs"
if [ -f "$SENDER_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-sender-verify.mjs >/tmp/sender-guard.log 2>&1); then
    echo "[sender-guard] commit blocked - the verified-sender check no longer holds:" >&2
    tail -20 /tmp/sender-guard.log >&2
    echo "[sender-guard] see scripts/test-sender-verify.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Blocks guard. /api/blocks answers an opponent's case, and the one
# thing it must never do is hand a debater a citation to read. A
# fabricated card read in a real round loses that round and costs the
# coach relationship permanently, which is a worse failure than any
# bug in this repo. The prompt forbids it; scrubFabricatedCites is the
# enforcement, and this guards the enforcement.
# ──────────────────────────────────────────────────────────────────
BLOCKS_GUARD="$REPO_ROOT/scripts/test-blocks-scrub.mjs"
if [ -f "$BLOCKS_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-blocks-scrub.mjs >/tmp/blocks-guard.log 2>&1); then
    echo "[blocks-guard] commit blocked - the no-fabricated-citation guarantee no longer holds:" >&2
    tail -20 /tmp/blocks-guard.log >&2
    echo "[blocks-guard] see scripts/test-blocks-scrub.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Discord guard. /api/discord/interactions is a public URL, and the
# Ed25519 check is the entire security model: anything that gets past
# it can make the bot post in every server that installed us. Discord
# also REQUIRES a 401 on a bad signature and probes with deliberately
# invalid ones, so a weakened verifier breaks the integration too.
# ──────────────────────────────────────────────────────────────────
DISCORD_GUARD="$REPO_ROOT/scripts/test-discord-interactions.mjs"
if [ -f "$DISCORD_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-discord-interactions.mjs >/tmp/discord-guard.log 2>&1); then
    echo "[discord-guard] commit blocked - the bot's signature or reply guarantees no longer hold:" >&2
    tail -20 /tmp/discord-guard.log >&2
    echo "[discord-guard] see scripts/test-discord-interactions.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Outreach guard. Two promises: nothing in the Reddit path can post
# (the test SCANS THE SOURCE for Reddit's write endpoints, because the
# guarantee is that the capability does not exist), and a draft that
# reads as an advert never reaches a human to rubber-stamp. Getting
# either wrong gets the domain banned from the subreddits this is
# built to reach, which no later commit can undo.
# ──────────────────────────────────────────────────────────────────
OUTREACH_GUARD="$REPO_ROOT/scripts/test-reddit-queue.mjs"
if [ -f "$OUTREACH_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-reddit-queue.mjs >/tmp/outreach-guard.log 2>&1); then
    echo "[outreach-guard] commit blocked - the never-auto-post or draft-quality guarantees no longer hold:" >&2
    tail -20 /tmp/outreach-guard.log >&2
    echo "[outreach-guard] see scripts/test-reddit-queue.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Live-discourse guard. The LIVE DISCOURSE block injects phrasing
# harvested from X into debate prompts. Two ways that goes wrong quietly:
# it reaches the JUDGE (a ballot informed by platform opinion breaks the
# judge charter), or its "this is not evidence" guardrail is edited out
# (the model then cites posts as proof and drifts toward whichever side
# had more volume). Both are silent in output, so they are asserted here.
# ──────────────────────────────────────────────────────────────────
DISCOURSE_GUARD="$REPO_ROOT/scripts/test-discourse.mjs"
if [ -f "$DISCOURSE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-discourse.mjs >/tmp/discourse-guard.log 2>&1); then
    echo "[discourse-guard] commit blocked - the live-discourse block's guarantees no longer hold:" >&2
    tail -20 /tmp/discourse-guard.log >&2
    echo "[discourse-guard] see scripts/test-discourse.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Opinion-panel guard. The panel is a measurement instrument: a reworded
# stem or a duplicate id silently breaks comparability with every answer
# already collected, and nothing about the incoming data looks wrong
# afterwards. Also asserts the aggregate maths ignores repeat answers, so
# a returning panelist cannot drag the published percentages. Verified
# non-vacuous by injecting each regression and watching it fail.
# ──────────────────────────────────────────────────────────────────
STANCE_GUARD="$REPO_ROOT/scripts/test-stance-panel.mjs"
if [ -f "$STANCE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-stance-panel.mjs >/tmp/stance-guard.log 2>&1); then
    echo "[stance-guard] commit blocked - the opinion panel's instrument changed:" >&2
    tail -20 /tmp/stance-guard.log >&2
    echo "[stance-guard] see scripts/test-stance-panel.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Wager gate: 18+ and jurisdiction on every staking path. This one
# guards a promise made to minors, so it blocks rather than warns.
# Verified non-vacuous by three injected regressions (attestation
# overriding a minor age range, unknown country passing a live
# blocklist, and caching the fail-closed error); each was caught.
# ──────────────────────────────────────────────────────────────────
JUDGE_RUN_GUARD="$REPO_ROOT/scripts/test-judge-run.mjs"
if [ -f "$JUDGE_RUN_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-judge-run.mjs >/tmp/judge-run-guard.log 2>&1); then
    echo "[judge-run-guard] commit blocked - the shared panel runner changed:" >&2
    tail -20 /tmp/judge-run-guard.log >&2
    echo "[judge-run-guard] see scripts/test-judge-run.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# Tournament-round guard. This decides whether a live round rates
# AUTOMATICALLY, which publishes a competitive record with someone's name
# on it. The failure that matters is a casual round rating because a
# client-supplied hint was trusted, so the guard pins that verification
# goes through the tournament's own entries and never through the room
# string or a query param.
TROUND_GUARD="$REPO_ROOT/scripts/test-tournament-round.mjs"
if [ -f "$TROUND_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-tournament-round.mjs >/tmp/tround-guard.log 2>&1); then
    echo "[tournament-round-guard] commit blocked - the auto-rating consent check changed:" >&2
    tail -20 /tmp/tround-guard.log >&2
    echo "[tournament-round-guard] see scripts/test-tournament-round.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# The two rules that decide a cash placement at the Open: the points
# ledger that ranks a drop-in day, and the crowd verdict that decides the
# final. Both are published in the tournament rules before the event, so
# a change here changes the terms of a contest rather than a sort order.
for GUARD in test-tournament-live test-crowd-verdict; do
  if [ -f "$REPO_ROOT/scripts/$GUARD.mjs" ] && command -v node >/dev/null 2>&1; then
    if ! (cd "$REPO_ROOT" && node "scripts/$GUARD.mjs" >"/tmp/$GUARD.log" 2>&1); then
      echo "[$GUARD] commit blocked - a published tournament rule changed:" >&2
      tail -20 "/tmp/$GUARD.log" >&2
      echo "[$GUARD] see scripts/$GUARD.mjs. Never bypass with --no-verify." >&2
      exit 1
    fi
  fi
done

WAGER_GUARD="$REPO_ROOT/scripts/test-wager-eligibility.mjs"
if [ -f "$WAGER_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-wager-eligibility.mjs >/tmp/wager-guard.log 2>&1); then
    echo "[wager-guard] commit blocked - the 18+/jurisdiction gate changed:" >&2
    tail -20 /tmp/wager-guard.log >&2
    echo "[wager-guard] see scripts/test-wager-eligibility.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# Value-market guard. The properties it holds are the ones that decide
# whether a trader can extract credits without being right: an instant
# round trip never profits, rounding never favours the trader, the house
# loss stays inside the LMSR bound at every possible close, and a market
# with no final rating pays nobody. It also greps the module for
# randomness, because the Floor shipped a coin-flip settlement once and
# it stood for months.
VALUE_GUARD="$REPO_ROOT/scripts/test-value-market.mjs"
if [ -f "$VALUE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-value-market.mjs >/tmp/value-guard.log 2>&1); then
    echo "[value-guard] commit blocked - a debater-market money property broke:" >&2
    tail -20 /tmp/value-guard.log >&2
    echo "[value-guard] see scripts/test-value-market.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Netlify-function import guard. Blocks a commit that stages a function
# importing a name a sibling lib module does not export (the repeated
# `json` vs `jsonResponse` mistake), or importing a lib module that
# does not exist.
#
# Why a hook: these fail at Netlify "Functions bundling" with exit 2,
# and a bundling failure blocks EVERY deploy, not just the broken
# function — the site serves a stale build while unrelated commits
# queue behind it. It happened seven times across four commits on
# 2026-07-31 alone. Static parse, no deps, ~80ms on the whole tree.
# Same hard-fail, soft-skip posture as the guards above.
# ──────────────────────────────────────────────────────────────────
IMPORT_GUARD="$REPO_ROOT/scripts/check-function-imports.mjs"
if [ -f "$IMPORT_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/check-function-imports.mjs); then
    echo "[import-guard] commit blocked — fix the import(s) above. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Precompile inline <script data-precompile="es5"> blocks before
# anything else. Why first: the precompile may mutate staged HTML,
# which downstream steps (sw.js cache bump) need to see.
#
# AGENTS.md context: index.html / practice.html / etc. ship a 14k+
# line inline React-via-CDN script. Loading babel-standalone at
# runtime to parse it cost ~600MB of heap per tab. Now we pre-
# transpile const/let → var (matches Babel's loose hoisting) at
# commit time. Idempotent — re-running on already-var output is a
# no-op.
#
# Only fires if the precompile script + Node toolchain exist; on
# fresh clones without `npm install` in app/ this silently skips.
# ──────────────────────────────────────────────────────────────────
PRECOMPILE_SCRIPT="$REPO_ROOT/scripts/precompile-inline-babel.mjs"
if [ -f "$PRECOMPILE_SCRIPT" ] && command -v node >/dev/null 2>&1 && [ -d "$REPO_ROOT/app/node_modules/@babel/core" ]; then
  PRECOMPILE_TARGETS="$(
    printf '%s\n' "$STAGED" \
      | grep -E '^app/.+\.html$' \
      | xargs -I{} grep -l 'data-precompile="es5"' "$REPO_ROOT/{}" 2>/dev/null \
      || true
  )"
  if [ -n "$PRECOMPILE_TARGETS" ]; then
    REL_TARGETS="$(printf '%s\n' "$PRECOMPILE_TARGETS" | sed "s|$REPO_ROOT/||")"
    # shellcheck disable=SC2086
    if (cd "$REPO_ROOT" && node scripts/precompile-inline-babel.mjs $REL_TARGETS >/tmp/precompile-hook.log 2>&1); then
      # Re-stage any files the precompile mutated.
      for f in $REL_TARGETS; do
        if ! git diff --quiet -- "$f" 2>/dev/null; then
          git add "$f" 2>/dev/null || true
          echo "[precompile] re-staged $f"
        fi
      done
    else
      echo "[precompile] warn: precompile failed — see /tmp/precompile-hook.log" >&2
    fi
  fi
fi

# If the user is already touching sw.js in this commit, trust them.
# They either bumped manually or are intentionally editing the SW
# logic itself — we don't want to clobber their version choice.
if printf '%s\n' "$STAGED" | grep -qE '^(app/)?sw\.js$'; then
  exit 0
fi

# Look for client-side file changes that should invalidate the cache.
# Server-side .mjs functions never reach the browser, so they're excluded.
TRIGGERS="$(
  printf '%s\n' "$STAGED" \
    | grep -E '\.(html|js|mjs|css)$' \
    | grep -vE '^app/netlify/functions/' \
    | grep -vE '^netlify/functions/' \
    || true
)"
[ -z "$TRIGGERS" ] && exit 0

# Read the current version from app/sw.js (authoritative side per AGENTS.md).
CURRENT="$(grep -oE "debateos-v[0-9]+" "$SW_APP" | head -1 || true)"
if [ -z "$CURRENT" ]; then
  echo "[sw-bump] warn: couldn't find debateos-vN in $SW_APP — skipping auto-bump" >&2
  exit 0
fi

NUM="$(printf '%s' "$CURRENT" | grep -oE '[0-9]+$')"
NEXT="$((NUM + 1))"
NEW="debateos-v${NEXT}"

# Portable in-place edit (BSD sed on macOS needs the empty backup arg;
# the .bak trick is the portable workaround that works on both BSD and GNU).
if ! sed -i.bak -E "s/debateos-v[0-9]+/${NEW}/g" "$SW_APP" "$SW_ROOT" 2>/dev/null; then
  echo "[sw-bump] warn: sed failed bumping CACHE_NAME — skipping" >&2
  rm -f "$SW_APP.bak" "$SW_ROOT.bak"
  exit 0
fi
rm -f "$SW_APP.bak" "$SW_ROOT.bak"

# Re-stage the bumped files so they ride along on the commit.
git add "$SW_APP" "$SW_ROOT" 2>/dev/null || true

# One-line summary so the dev can see exactly what fired and why.
TRIGGER_COUNT="$(printf '%s\n' "$TRIGGERS" | wc -l | tr -d ' ')"
echo "[sw-bump] ${CURRENT} → ${NEW} (${TRIGGER_COUNT} client file$([ "$TRIGGER_COUNT" = "1" ] || echo s) changed)"

exit 0
