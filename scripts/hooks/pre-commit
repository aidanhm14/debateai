    tail -20 /tmp/blocks-guard.log >&2
    echo "[blocks-guard] see scripts/test-blocks-scrub.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Discord guard. /api/discord/interactions is a public URL, and the
# Ed25519 check is the entire security model: anything that gets past
# it can make the bot post in every server that installed us. Discord
# also REQUIRES a 401 on a bad signature and probes with deliberately
# invalid ones, so a weakened verifier breaks the integration too.
# ──────────────────────────────────────────────────────────────────
DISCORD_GUARD="$REPO_ROOT/scripts/test-discord-interactions.mjs"
if [ -f "$DISCORD_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-discord-interactions.mjs >/tmp/discord-guard.log 2>&1); then
