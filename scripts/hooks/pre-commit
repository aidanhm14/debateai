    tail -20 /tmp/discord-guard.log >&2
    echo "[discord-guard] see scripts/test-discord-interactions.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Outreach guard. Two promises: nothing in the Reddit path can post
# (the test SCANS THE SOURCE for Reddit's write endpoints, because the
# guarantee is that the capability does not exist), and a draft that
# reads as an advert never reaches a human to rubber-stamp. Getting
# either wrong gets the domain banned from the subreddits this is
# built to reach, which no later commit can undo.
# ──────────────────────────────────────────────────────────────────
OUTREACH_GUARD="$REPO_ROOT/scripts/test-reddit-queue.mjs"
if [ -f "$OUTREACH_GUARD" ] && command -v node >/dev/null 2>&1; then
