    tail -20 /tmp/outreach-guard.log >&2
    echo "[outreach-guard] see scripts/test-reddit-queue.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Live-discourse guard. The LIVE DISCOURSE block injects phrasing
# harvested from X into debate prompts. Two ways that goes wrong quietly:
# it reaches the JUDGE (a ballot informed by platform opinion breaks the
# judge charter), or its "this is not evidence" guardrail is edited out
# (the model then cites posts as proof and drifts toward whichever side
# had more volume). Both are silent in output, so they are asserted here.
# ──────────────────────────────────────────────────────────────────
DISCOURSE_GUARD="$REPO_ROOT/scripts/test-discourse.mjs"
if [ -f "$DISCOURSE_GUARD" ] && command -v node >/dev/null 2>&1; then
