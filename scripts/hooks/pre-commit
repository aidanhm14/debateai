# Tournament-round guard. This decides whether a live round rates
# AUTOMATICALLY, which publishes a competitive record with someone's name
# on it. The failure that matters is a casual round rating because a
# client-supplied hint was trusted, so the guard pins that verification
# goes through the tournament's own entries and never through the room
# string or a query param.
TROUND_GUARD="$REPO_ROOT/scripts/test-tournament-round.mjs"
if [ -f "$TROUND_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-tournament-round.mjs >/tmp/tround-guard.log 2>&1); then
    echo "[tournament-round-guard] commit blocked - the auto-rating consent check changed:" >&2
    tail -20 /tmp/tround-guard.log >&2
    echo "[tournament-round-guard] see scripts/test-tournament-round.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# The two rules that decide a cash placement at the Open: the points
# ledger that ranks a drop-in day, and the crowd verdict that decides the
# final. Both are published in the tournament rules before the event, so
# a change here changes the terms of a contest rather than a sort order.
for GUARD in test-tournament-live test-crowd-verdict; do
  if [ -f "$REPO_ROOT/scripts/$GUARD.mjs" ] && command -v node >/dev/null 2>&1; then
    if ! (cd "$REPO_ROOT" && node "scripts/$GUARD.mjs" >"/tmp/$GUARD.log" 2>&1); then
      echo "[$GUARD] commit blocked - a published tournament rule changed:" >&2
      tail -20 "/tmp/$GUARD.log" >&2
      echo "[$GUARD] see scripts/$GUARD.mjs. Never bypass with --no-verify." >&2
      exit 1
    fi
  fi
done

# The live fact checker speaks to an audience mid-round. Its quote gate is
