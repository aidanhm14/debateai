    tail -20 /tmp/clash-guard.log >&2
    echo "[clash-guard] see scripts/test-clash-live.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

SMS_GUARD="$REPO_ROOT/scripts/test-sms.mjs"
if [ -f "$SMS_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-sms.mjs >/tmp/sms-guard.log 2>&1); then
    echo "[sms-guard] commit blocked - the SMS consent rules no longer hold:" >&2
    tail -20 /tmp/sms-guard.log >&2
    echo "[sms-guard] see scripts/test-sms.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Cash-round money guard. A cash round is the one surface where real
# money moves on the result of an argument, so its four promises (fee
# at the door only, winner takes the whole pot, no verdict means a full
# refund, nothing pays before the appeal window closes) are asserted
# rather than reviewed.
CASH_GUARD="$REPO_ROOT/scripts/test-cash-round.mjs"
if [ -f "$CASH_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-cash-round.mjs >/tmp/cash-guard.log 2>&1); then
    echo "[cash-guard] commit blocked - the cash-round money rules no longer hold:" >&2
    tail -20 /tmp/cash-guard.log >&2
    echo "[cash-guard] see scripts/test-cash-round.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Payout guard. cash-round decides whether a pot is OWED; this covers
# whether it can be SENT, which is the half where money actually
# leaves the account. Double-send prevention lives here.
PAYOUT_GUARD="$REPO_ROOT/scripts/test-payout.mjs"
if [ -f "$PAYOUT_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-payout.mjs >/tmp/payout-guard.log 2>&1); then
    echo "[payout-guard] commit blocked - the payout rail rules no longer hold:" >&2
    tail -20 /tmp/payout-guard.log >&2
    echo "[payout-guard] see scripts/test-payout.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Send-quota guard. The sender guard below catches a wrong From. This
# one catches the other half of the same 2026-08-12 failure: the day's
# allowance running out mid-cohort while the run kept going and still
# recorded status:'done'. Asserts that a daily-quota 429 is told apart
# from a rate-limit 429, that the loop stops on the first one, and that
# a retry targets only the people who were never reached.
# ──────────────────────────────────────────────────────────────────
QUOTA_GUARD="$REPO_ROOT/scripts/test-spar-night-quota.mjs"
if [ -f "$QUOTA_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT/scripts" && node test-spar-night-quota.mjs >/tmp/quota-guard.log 2>&1); then
    echo "[quota-guard] commit blocked - send-quota handling no longer holds:" >&2
    tail -20 /tmp/quota-guard.log >&2
    echo "[quota-guard] see scripts/test-spar-night-quota.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Sender guard. Resend authenticates the sending DOMAIN, not the
# mailbox, and it REJECTS an unverified From at the API rather than
# bouncing it later, so a wrong sender is a run of silent 403s in an
# error tally nobody reads. That is not hypothetical: it is how Spar
# Night mailed zero people between 2026-07-22 and 08-05. The check
# asks Resend what is verified instead of trusting a hardcoded list,
# and it has to keep failing CLOSED when the answer cannot be had.
# ──────────────────────────────────────────────────────────────────
SENDER_GUARD="$REPO_ROOT/scripts/test-sender-verify.mjs"
if [ -f "$SENDER_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-sender-verify.mjs >/tmp/sender-guard.log 2>&1); then
    echo "[sender-guard] commit blocked - the verified-sender check no longer holds:" >&2
    tail -20 /tmp/sender-guard.log >&2
    echo "[sender-guard] see scripts/test-sender-verify.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Blocks guard. /api/blocks answers an opponent's case, and the one
# thing it must never do is hand a debater a citation to read. A
# fabricated card read in a real round loses that round and costs the
# coach relationship permanently, which is a worse failure than any
# bug in this repo. The prompt forbids it; scrubFabricatedCites is the
# enforcement, and this guards the enforcement.
# ──────────────────────────────────────────────────────────────────
BLOCKS_GUARD="$REPO_ROOT/scripts/test-blocks-scrub.mjs"
if [ -f "$BLOCKS_GUARD" ] && command -v node >/dev/null 2>&1; then
