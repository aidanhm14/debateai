    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Cheap-router guard. lib/cheap.mjs decides which VENDOR a dozen
# internal tasks are sent to. A bad edit does not break one endpoint,
# it silently routes work to the wrong company with the wrong key, or
# re-enables reasoning and starts truncating every structured task
# inside the ~26s Netlify budget. Both present as "the parser broke"
# at call sites nobody touched.
# ──────────────────────────────────────────────────────────────────
CHEAP_GUARD="$REPO_ROOT/scripts/test-cheap-router.mjs"
if [ -f "$CHEAP_GUARD" ] && command -v node >/dev/null 2>&1; then
