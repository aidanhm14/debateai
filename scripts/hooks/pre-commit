# Value-market guard. The properties it holds are the ones that decide
# whether a trader can extract credits without being right: an instant
# round trip never profits, rounding never favours the trader, the house
# loss stays inside the LMSR bound at every possible close, and a market
# with no final rating pays nobody. It also greps the module for
# randomness, because the Floor shipped a coin-flip settlement once and
# it stood for months.
VALUE_GUARD="$REPO_ROOT/scripts/test-value-market.mjs"
if [ -f "$VALUE_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-value-market.mjs >/tmp/value-guard.log 2>&1); then
    echo "[value-guard] commit blocked - a debater-market money property broke:" >&2
    tail -20 /tmp/value-guard.log >&2
    echo "[value-guard] see scripts/test-value-market.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# Ballot reading-depth guard. A ballot surface only stops being a wall
# of text while all three of its depths are still declared. Dropping a
# tier from one page silently restores the old behaviour there and
# nothing errors, which is the class of failure this repo keeps finding
# by hand months later. Also holds the CSS rules, the AA contrast on the
# selected pill, the rule that the summary never invents text, and the
# line between this control and the judge-delivery LENGTH picked before
# a round.
# ──────────────────────────────────────────────────────────────────
BREAD_GUARD="$REPO_ROOT/scripts/test-ballot-read.mjs"
if [ -f "$BREAD_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-ballot-read.mjs >/tmp/ballot-read-guard.log 2>&1); then
    echo "[ballot-read] commit blocked - a ballot reading-depth promise broke:" >&2
    grep '^  FAIL' /tmp/ballot-read-guard.log >&2 || tail -20 /tmp/ballot-read-guard.log >&2
    echo "[ballot-read] see scripts/test-ballot-read.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Netlify-function import guard. Blocks a commit that stages a function
# importing a name a sibling lib module does not export (the repeated
# `json` vs `jsonResponse` mistake), or importing a lib module that
# does not exist.
#
# Why a hook: these fail at Netlify "Functions bundling" with exit 2,
# and a bundling failure blocks EVERY deploy, not just the broken
# function — the site serves a stale build while unrelated commits
# queue behind it. It happened seven times across four commits on
# 2026-07-31 alone. Static parse, no deps, ~80ms on the whole tree.
# Same hard-fail, soft-skip posture as the guards above.
# ──────────────────────────────────────────────────────────────────
IMPORT_GUARD="$REPO_ROOT/scripts/check-function-imports.mjs"
if [ -f "$IMPORT_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/check-function-imports.mjs); then
    echo "[import-guard] commit blocked — fix the import(s) above. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Precompile inline <script data-precompile="es5"> blocks before
# anything else. Why first: the precompile may mutate staged HTML,
# which downstream steps (sw.js cache bump) need to see.
#
# AGENTS.md context: index.html / practice.html / etc. ship a 14k+
# line inline React-via-CDN script. Loading babel-standalone at
# runtime to parse it cost ~600MB of heap per tab. Now we pre-
# transpile const/let → var (matches Babel's loose hoisting) at
# commit time. Idempotent — re-running on already-var output is a
# no-op.
#
# Only fires if the precompile script + Node toolchain exist; on
# fresh clones without `npm install` in app/ this silently skips.
# ──────────────────────────────────────────────────────────────────
PRECOMPILE_SCRIPT="$REPO_ROOT/scripts/precompile-inline-babel.mjs"
if [ -f "$PRECOMPILE_SCRIPT" ] && command -v node >/dev/null 2>&1 && [ -d "$REPO_ROOT/app/node_modules/@babel/core" ]; then
  PRECOMPILE_TARGETS="$(
    printf '%s\n' "$STAGED" \
      | grep -E '^app/.+\.html$' \
      | xargs -I{} grep -l 'data-precompile="es5"' "$REPO_ROOT/{}" 2>/dev/null \
      || true
  )"
  if [ -n "$PRECOMPILE_TARGETS" ]; then
    REL_TARGETS="$(printf '%s\n' "$PRECOMPILE_TARGETS" | sed "s|$REPO_ROOT/||")"
    # shellcheck disable=SC2086
    if (cd "$REPO_ROOT" && node scripts/precompile-inline-babel.mjs $REL_TARGETS >/tmp/precompile-hook.log 2>&1); then
      # Re-stage any files the precompile mutated.
      for f in $REL_TARGETS; do
        if ! git diff --quiet -- "$f" 2>/dev/null; then
          git add "$f" 2>/dev/null || true
          echo "[precompile] re-staged $f"
        fi
      done
    else
      echo "[precompile] warn: precompile failed — see /tmp/precompile-hook.log" >&2
    fi
  fi
fi

# If the user is already touching sw.js in this commit, trust them.
# They either bumped manually or are intentionally editing the SW
# logic itself — we don't want to clobber their version choice.
# Trusting the version choice does not mean trusting the bytes:
# the staged copies still have to parse.
if printf '%s\n' "$STAGED" | grep -qE '^(app/)?sw\.js$'; then
  sw_integrity app/sw.js || exit 1
  sw_integrity sw.js || exit 1
  exit 0
fi

# Look for client-side file changes that should invalidate the cache.
# Server-side .mjs functions never reach the browser, so they're excluded.
TRIGGERS="$(
  printf '%s\n' "$STAGED" \
    | grep -E '\.(html|js|mjs|css)$' \
    | grep -vE '^app/netlify/functions/' \
    | grep -vE '^netlify/functions/' \
    || true
)"
[ -z "$TRIGGERS" ] && exit 0

# Read the current version from app/sw.js (authoritative side per AGENTS.md).
CURRENT="$(grep -oE "debateos-v[0-9]+" "$SW_APP" | head -1 || true)"
if [ -z "$CURRENT" ]; then
  echo "[sw-bump] warn: couldn't find debateos-vN in $SW_APP — skipping auto-bump" >&2
  exit 0
fi

NUM="$(printf '%s' "$CURRENT" | grep -oE '[0-9]+$')"
NEXT="$((NUM + 1))"
NEW="debateos-v${NEXT}"

# Portable in-place edit (BSD sed on macOS needs the empty backup arg;
# the .bak trick is the portable workaround that works on both BSD and GNU).
if ! sed -i.bak -E "s/debateos-v[0-9]+/${NEW}/g" "$SW_APP" "$SW_ROOT" 2>/dev/null; then
  echo "[sw-bump] warn: sed failed bumping CACHE_NAME — skipping" >&2
  rm -f "$SW_APP.bak" "$SW_ROOT.bak"
  exit 0
fi
rm -f "$SW_APP.bak" "$SW_ROOT.bak"

# Re-stage the bumped files so they ride along on the commit.
git add "$SW_APP" "$SW_ROOT" 2>/dev/null || true

# The auto-bump stages the whole working-tree file, not just the version
# line — so if the working copy was carrying conflict markers, the bump
# just staged them. Verify what actually landed in the index.
sw_integrity app/sw.js || exit 1
sw_integrity sw.js || exit 1

# One-line summary so the dev can see exactly what fired and why.
TRIGGER_COUNT="$(printf '%s\n' "$TRIGGERS" | wc -l | tr -d ' ')"
echo "[sw-bump] ${CURRENT} → ${NEW} (${TRIGGER_COUNT} client file$([ "$TRIGGER_COUNT" = "1" ] || echo s) changed)"

exit 0
