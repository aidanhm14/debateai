    echo "[cheap-guard] see scripts/test-cheap-router.mjs. Never bypass with --no-verify." >&2
    exit 1
  fi
fi

# ──────────────────────────────────────────────────────────────────
# Bounty money guard. A bounty holds real money that two people are
# about to be paid out of, so the three promises the board makes to a
# stranger are asserted rather than reviewed: the pot pays for
# COMPLETING the round and never for winning (so the AI judge cannot be
# worth corrupting), the house takes nothing to the cent, and money
# that produces no debate is refundable. Also guards the claim rules,
# so a funder cannot pay themselves and a stranger cannot take a bounty
# aimed at someone else.
# ──────────────────────────────────────────────────────────────────
BOUNTY_GUARD="$REPO_ROOT/scripts/test-bounty.mjs"
if [ -f "$BOUNTY_GUARD" ] && command -v node >/dev/null 2>&1; then
  if ! (cd "$REPO_ROOT" && node scripts/test-bounty.mjs >/tmp/bounty-guard.log 2>&1); then
