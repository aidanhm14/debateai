<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap index. Points Googlebot at three sub-sitemaps:

  - /sitemap.xml          core: landing, pricing, topic pages, guides,
                          product and audience pages. Server-generated by
                          app/netlify/functions/sitemap.mjs.
  - /sitemap-rounds.xml   dynamic: every /r/{id} published round. Served
                          by app/netlify/functions/sitemap-rounds.mjs,
                          1h edge cache, 5000-URL cap.
  - /sitemap-motions.xml  dynamic: last 180 days of /today/{YYYY-MM-DD}.
                          Served by app/netlify/functions/sitemap-motions.mjs,
                          6h edge cache. Bare /today is included.
  - /sitemap-recordings.xml
                          dynamic: every published /w/{id} recording page.
                          Served by app/netlify/functions/sitemap-recordings.mjs,
                          1h edge cache. Publish state is the only gate, so a
                          round the debaters did not agree to publish is never
                          submitted for crawl. Carries /watch as a fallback
                          entry while the corpus is empty.

  The split lets the dynamic collections live behind their own cache
  policies without forcing the whole sitemap into a function call on
  every Googlebot read.
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://itsdebatable.com/sitemap.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://itsdebatable.com/sitemap-rounds.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://itsdebatable.com/sitemap-motions.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://itsdebatable.com/sitemap-programs.xml</loc>
  </sitemap>
  <sitemap>
    <loc>https://itsdebatable.com/sitemap-recordings.xml</loc>
  </sitemap>
</sitemapindex>
